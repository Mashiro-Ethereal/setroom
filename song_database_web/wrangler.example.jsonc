{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "setroom",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "setroom-db",
      // Local development uses a separate local database. Replace this ID
      // with the ID returned by `wrangler d1 create` before remote deployment.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": false }
}
